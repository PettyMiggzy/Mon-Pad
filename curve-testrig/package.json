{
  "name": "curve-testrig",
  "version": "0.1.0",
  "private": true,
  "description": "Research rig for measuring bonding-curve behaviour on Uniswap V4. NOT a production launchpad \u2014 exists to run simulations against real curve contracts and is not intended to launch tokens with real value.",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test test/unit/MonPadV4FeeConfig.test.js test/unit/MonPadCurveV4.test.js test/unit/MonshiBuyback.test.js",
    "test:all": "hardhat test",
    "test:sim": "hardhat test test/sim/curve.calibration.sim.test.js test/sim/curve.graduation.sim.test.js",
    "test:fork": "hardhat test test/fork/CurveGraduation.fork.test.js",
    "postinstall": "node scripts/link-v4-libs.js",
    "keeper": "node scripts/auto-graduate.cjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.10"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@uniswap/v4-core": "^1.0.2",
    "@uniswap/v4-periphery": "^1.0.2",
    "dotenv": "^17.4.2"
  }
}
