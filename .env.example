# Monpad frontend — copy to .env.local (gitignored). Never commit secrets.

# WalletConnect (https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Monad mainnet (143) RPC — set real values in .env.local / Vercel only
NEXT_PUBLIC_RPC_URL=https://YOUR-ENDPOINT.monad-mainnet.quiknode.pro/YOUR_TOKEN/
NEXT_PUBLIC_RPC_URL_FALLBACK=https://rpc.monad.xyz
NEXT_PUBLIC_RPC_WSS=wss://YOUR-ENDPOINT.monad-mainnet.quiknode.pro/YOUR_TOKEN/
RPC_URL=https://rpc.monad.xyz

# Optional API host (health / legacy)
NEXT_PUBLIC_SERVER_URL=https://api.monpad.net
NEXT_PUBLIC_INDEXER_URL=https://api.monpad.net
NEXT_PUBLIC_MOCK_MODE=0

# ── Contracts (set AFTER clean redeploy — empty board until set) ───────────
NEXT_PUBLIC_FACTORY_V3=0xYOUR_NEW_FACTORY
NEXT_PUBLIC_GRADUATOR_V3=0xYOUR_NEW_GRADUATOR

# ── Supabase = original bond-pad storage (token PFPs + meta) ───────────────
# Same path as before: /api/upload → bucket "images", /api/token-meta → table "token_meta"
# Run supabase/schema.sql once in the Supabase SQL editor if the project is fresh.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Fee receivers (Minta platform treasury carried over)
NEXT_PUBLIC_PLATFORM_WALLET=0x5899a0576A94327a6316E01190f951edf7645914
NEXT_PUBLIC_TREASURY_WALLET=0x5899a0576A94327a6316E01190f951edf7645914
NEXT_PUBLIC_BUYBACK_WALLET=0x5899a0576A94327a6316E01190f951edf7645914

NEXT_PUBLIC_MONORAIL_PARTNER_ID=1176408161626

# Optional Meshy (local art gen only — keep out of git)
# MESHY_API_KEY=msy_…
