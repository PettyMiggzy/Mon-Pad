# Mon-Pad V2.1 Frontend Environment
# Copy to .env.local (gitignored) and fill in real values.

# WalletConnect (get yours at https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# Backend / indexer
NEXT_PUBLIC_SERVER_URL=https://api.monpad.net
NEXT_PUBLIC_INDEXER_URL=https://api.monpad.net

# Mock mode (1 = synthetic homepage data, 0 = real indexer data)
NEXT_PUBLIC_MOCK_MODE=1

# Deployed contracts on Monad mainnet (chain 143)
NEXT_PUBLIC_FACTORY_V2=0xYOUR_FACTORY_ADDRESS_HERE
NEXT_PUBLIC_HUB=0xYOUR_STAKING_HUB_ADDRESS_HERE
NEXT_PUBLIC_POOL_FACTORY=0xYOUR_POOL_FACTORY_ADDRESS_HERE
NEXT_PUBLIC_GRADUATOR=0xYOUR_GRADUATOR_ADDRESS_HERE

# Treasury / fee receivers
NEXT_PUBLIC_PLATFORM_WALLET=0xYOUR_PLATFORM_WALLET_HERE
NEXT_PUBLIC_TREASURY_WALLET=0xYOUR_TREASURY_WALLET_HERE
NEXT_PUBLIC_BUYBACK_WALLET=0xYOUR_BUYBACK_WALLET_HERE

# Monorail Pathfinder partner ID (for swap page)
NEXT_PUBLIC_MONORAIL_PARTNER_ID=YOUR_MONORAIL_PARTNER_ID
