# Mon-Pad bot config — copy to bot/.env and fill in. NEVER commit real values.
# Load with:  set -a; . ./bot/.env; set +a   (or use pm2 --env / systemd EnvironmentFile)

# --- required ---
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_CHAT_ID=@monpadtrending   # the group; @username works if the group is public, else the numeric -100... id

# --- chain (keep your QuickNode/private RPC here, server-side only) ---
RPC_URL=https://rpc.monad.xyz
FACTORY_V3=0x45Fb501E1167FbBfEBf42206A3C9945F13C70aaF

# --- links ---
SITE_URL=https://www.monpad.net

# --- buy alerts ---
MIN_BUY_USD=100
POLL_MS=6000
MAX_CATCHUP_BLOCKS=2000

# --- trending ---
TREND_WINDOW_SEC=3600         # rolling window for "trending" volume
TREND_THRESHOLD_USD=500       # window volume that makes a token trend
TREND_CHECK_MS=60000
TREND_COOLDOWN_SEC=10800      # min seconds between re-announcing the same token

# --- paid trending (MONSHI-paid, on-chain boost) ---
# MonPadBoostMonshi: 70% burn / 30% treasury, tiered (5M MONSHI->48h, 10M->5d).
# Trend duration comes from the contract event, so no per-hour rate here.
BOOST_CONTRACT=0xE50Ab41eAE60309d06a6aaA699f5E5786D78e4DA
ADMIN_ID=6820752140           # Telegram id allowed to run admin actions

# --- DexScreener enrichment (keyless read API, chainId 'monad') ---
DS_CACHE_TTL_MS=60000         # cache a listed pair
DS_NEG_CACHE_TTL_MS=300000    # cache "not listed yet" (pre-graduation)
CURVE_PRICE_TTL_MS=15000      # cache on-chain curve price (fallback before listing)

# --- optional ---
MON_USD_FALLBACK=0            # used only if DexScreener is unreachable
TOKENS_REFRESH_MS=120000
