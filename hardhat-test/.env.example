# Mon-Pad V2.1 deploy environment template
# Copy to .env (gitignored) and fill in values before running scripts.
# DO NOT commit .env with real values.
#
# Required for deploy:
# Deployer private key (NEVER commit the real .env)
DEPLOYER_KEY=0x...

# RPC endpoints (get QuickNode URL from your dashboard)
TESTNET_RPC=https://testnet-rpc.monad.xyz
MAINNET_RPC=https://YOUR-NAME.monad-mainnet.quiknode.pro/YOUR-TOKEN/

# Deploy constructor args
PLATFORM_WALLET=0xYOUR_PLATFORM_WALLET_HERE
TREASURY_WALLET=0xYOUR_TREASURY_ADDRESS_HERE
BUYBACK_WALLET=0xYOUR_BUYBACK_WALLET_HERE

# External contracts (mainnet)
WMON_ADDRESS=0x3bd359C1119dA7Da1D913D1C4D2B7c461115433A
NPM_ADDRESS=0xa9f6B6656e32F223d778b01642F32D00F5310526
MONSHI_ADDRESS=0xB744F5CDb792d8187640214C4A1c9aCE29af7777

# Swap deploy flag - confirmed false, Monorail is API-based not on-chain
DEPLOY_SWAP=false

# Set FORK_RPC to enable mainnet fork simulation (use Monad mainnet QuickNode URL)
# Do not commit a real value here — keep it in local .env only.
FORK_RPC=
