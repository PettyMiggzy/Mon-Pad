# Mon-Pad V2.1 deploy environment template
# Copy to .env (gitignored) and fill in values before running scripts.
# DO NOT commit .env with real values.
#
# Required for deploy:
# Deployer private key (NEVER commit the real .env)
DEPLOYER_KEY=0x...

# RPC endpoints (get QuickNode URL from your dashboard)
TESTNET_RPC=https://testnet-rpc.monad.xyz
MAINNET_RPC=https://monad-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deploy constructor args (Minta platform treasury carried over)
PLATFORM_WALLET=0x5899a0576A94327a6316E01190f951edf7645914
TREASURY_WALLET=0x5899a0576A94327a6316E01190f951edf7645914
BUYBACK_WALLET=0x5899a0576A94327a6316E01190f951edf7645914

# External contracts (mainnet)
WMON_ADDRESS=0x3bd359C1119dA7Da1D913D1C4D2B7c461115433A
# Official Uniswap V3 NonfungiblePositionManager (NOT the old 0xa9f6… NPM)
NPM_ADDRESS=0x7197e214c0b767cfb76fb734ab638e2c192f4e53
MONSHI_ADDRESS=0xB744F5CDb792d8187640214C4A1c9aCE29af7777

# Swap deploy flag - confirmed false, Monorail is API-based not on-chain
DEPLOY_SWAP=false

# FORK_RPC / MAINNET_RPC: Alchemy backup or QuickNode — never commit real keys
FORK_RPC=
