# REQUIRED
PRIVATE_KEY=your_deployer_private_key_no_0x_prefix

# RPC: primary used first, fallback on failure. Supports any HTTPS Monad endpoint.
# Get a paid one from QuickNode / Alchemy / Ankr — public free RPC will rate-limit under real load.
PRIMARY_RPC=https://your-paid-quicknode-or-alchemy-monad-url
FALLBACK_RPC=https://rpc.monad.xyz

# REQUIRED WALLETS
PLATFORM_WALLET=0x57C8A5AeC1c172fE41416A2FAE6eBDD92b552A16
TREASURY_WALLET=0x5dD4bF19C42d45FD414930eFE78D602c5975FFfd
BUYBACK_WALLET=0x_your_monshi_buyback_wallet

# OPTIONAL: Staking system
DEPLOY_STAKING=1
MONSHI_TOKEN=0xB744F5CDb792d8187640214C4A1c9aCE29af7777

# OPTIONAL: Swap wrapper
DEPLOY_SWAP=0
DEX_ROUTER=0x_existing_router
WMON=0x3bd359C1119dA7Da1D913D1C4D2B7c461115433A
