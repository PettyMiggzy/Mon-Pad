# ─────────────────────────────────────────────────────────────────────────
# MonPad V2.1 deploy environment.
# Copy this file to deploy/v2/.env and fill in your values.
# DO NOT commit deploy/v2/.env (it's in .gitignore).
# DO NOT paste PRIVATE_KEY into chat with any AI.
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED — your deployer wallet's private key (hex, NO 0x prefix).
# This wallet pays gas and becomes the owner of every contract.
PRIVATE_KEY=

# REQUIRED — RPC endpoints. Public RPC works for deploy but may rate-limit;
# get a paid one from QuickNode / Alchemy / Ankr if you have it.
PRIMARY_RPC=https://rpc.monad.xyz
FALLBACK_RPC=https://rpc.monad.xyz

# REQUIRED WALLETS
# WARNING: NEVER use 0x5dD4bF19C42d45FD414930eFE78D602c5975FFfd — keys are lost.
# The script will refuse to run if any wallet matches that address.
PLATFORM_WALLET=0x57C8A5AeC1c172fE41416A2FAE6eBDD92b552A16
TREASURY_WALLET=0xB9d4B73bE18914c6d64Bee65a806648370be467f
BUYBACK_WALLET=0xB9d4B73bE18914c6d64Bee65a806648370be467f

# REQUIRED IF DEPLOY_STAKING=1 (recommended) — Monad mainnet contract addresses.
DEPLOY_STAKING=1
MONSHI_TOKEN=0xB744F5CDb792d8187640214C4A1c9aCE29af7777
WMON=0x3bd359C1119dA7Da1D913D1C4D2B7c461115433A
NPM=0xa9f6B6656e32F223d778b01642F32D00F5310526

# OPTIONAL — vesting contract (non-binding, audit V2.1-8). Default OFF.
DEPLOY_VESTING=0

# OPTIONAL — swap wrapper. Default OFF (audit V2.1-7 docs note this needs a quoter
# integration before going live; defer unless you know what you're doing).
DEPLOY_SWAP=0
DEX_ROUTER=
