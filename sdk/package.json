{
  "name": "@monpad/sdk",
  "version": "0.2.0",
  "description": "Monpad Uniswap V4 SDK for Monad — read, quote, trade, launch",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "check:addresses": "node scripts/check-no-addresses.mjs",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run check:addresses && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
